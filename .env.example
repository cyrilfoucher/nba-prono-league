# Clé de l'API BALLDONTLIE. Sur https://app.balldontlie.io : créer un compte
# gratuit, copier la clé affichée dans le tableau de bord, puis la recopier
# dans un fichier .env.
BALLDONTLIE_API_KEY=

# Base PostgreSQL hébergée chez Neon. Dans le tableau de bord Neon, cliquer sur
# le bouton « Connect » du projet pour afficher les adresses de connexion.
# Format : postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Adresse avec pooling, utilisée par l'appli. Option « Connection pooling »
# activée : le nom d'hôte contient « -pooler ».
DATABASE_URL=

# Adresse directe, utilisée par la CLI Prisma pour les migrations. Option
# « Connection pooling » désactivée : le nom d'hôte ne contient pas « -pooler ».
DIRECT_URL=
